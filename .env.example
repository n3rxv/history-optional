# ── Supabase ──────────────────────────────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-anon-key
SUPABASE_SECRET_KEY=your-service-role-key
# Full database access, used only by scripts/dump-schema.sh to regenerate
# supabase/schema.sql. Dashboard -> Project Settings -> Database -> Connection
# string -> URI. Not needed to run the app.
SUPABASE_DB_URL=postgresql://postgres:PASSWORD@db.PROJECT.supabase.co:5432/postgres

# ── Groq ─────────────────────────────────────────────────────────────────────
GROQ_API_KEY=gsk_...
GROQ_API_KEY_2=gsk_...   # optional fallback key

# ── Razorpay ──────────────────────────────────────────────────────────────────
NEXT_PUBLIC_RAZORPAY_KEY_ID=rzp_live_...
RAZORPAY_KEY_ID=rzp_live_...
RAZORPAY_KEY_SECRET=your-razorpay-secret
# Razorpay Dashboard -> Settings -> Webhooks. This is NOT the key secret above —
# it is the separate secret you type in when creating the webhook. Without it
# /api/razorpay/webhook fails closed and paid-but-tab-closed users get nothing.
RAZORPAY_WEBHOOK_SECRET=your-webhook-secret

# ── Admin ─────────────────────────────────────────────────────────────────────
ADMIN_PASSWORD=choose-a-strong-password-here
ADMIN_SECRET=choose-a-separate-secret-for-signout-all

# ── Owner bypass (was hardcoded — now in env) ─────────────────────────────────
OWNER_EMAIL=your@email.com
OWNER_PHONE=+91XXXXXXXXXX
# Note: OWNER_EMAIL is also needed as NEXT_PUBLIC_ for the historiography page (client-side check)
NEXT_PUBLIC_OWNER_EMAIL=your@email.com

# ── Basemap tiles (optional) ──────────────────────────────────────────────────
# Free CARTO key, 5M tile requests/month, no account needed:
#   https://carto.com/basemaps/apikey/
# Leave unset to fall back to Esri's keyless canvas. A missing OR invalid key
# makes CARTO serve tiles watermarked "API KEY REQUIRED" with no HTTP error.
NEXT_PUBLIC_CARTO_KEY=

# ── Firebase (client SDK) ─────────────────────────────────────────────────────
# Firebase console -> Project Settings -> General -> Your apps -> SDK setup.
# Public by design; these ship in the browser bundle.
NEXT_PUBLIC_FIREBASE_API_KEY=AIza...
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=your-project
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=your-project.appspot.com
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=000000000000
NEXT_PUBLIC_FIREBASE_APP_ID=1:000000000000:web:abc123

# ── Firebase (admin SDK) ──────────────────────────────────────────────────────
# Project Settings -> Service Accounts -> Generate new private key.
# Server-side only. Token verification uses Google's public certs and works
# even if these are wrong, so a stale key here fails silently -- the symptom is
# app/invalid-credential on any call that needs to sign, not on sign-in.
# Keep the \n escapes; the code converts them back to newlines.
FIREBASE_PROJECT_ID=your-project
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@your-project.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMIIE...\n-----END PRIVATE KEY-----\n"

# ── AI providers ──────────────────────────────────────────────────────────────
ANTHROPIC_API_KEY=sk-ant-...      # evaluation, map checking, chat (Haiku)
GEMINI_API_KEY=AIza...            # handwriting OCR in /api/evaluate
VOYAGE_API_KEY=pa-...             # embeddings for book retrieval (RAG)
MISTRAL_API_KEY=...               # legacy; check whether anything still needs it

# ── Site ──────────────────────────────────────────────────────────────────────
# Absolute origin used for server-to-server calls. Set it in every environment:
# code that falls back to http://localhost:3000 silently no-ops in production.
NEXT_PUBLIC_SITE_URL=https://your-domain.com

# ── Cloudflare R2 (topper copy PDFs) ──────────────────────────────────────────
# Without these, lib/r2.ts falls back to the public bucket URL and logs a
# warning — the feature keeps working but the URLs are unsigned.
# Cloudflare dashboard -> R2 -> Manage API Tokens -> Create (Object Read only).
R2_ACCOUNT_ID=your-cloudflare-account-id
R2_ACCESS_KEY_ID=...
R2_SECRET_ACCESS_KEY=...
R2_BUCKET=your-bucket-name
# Only used for the fallback above. Remove the bucket's public development URL
# in Cloudflare once signed URLs are confirmed working — that is the step that
# actually revokes object keys already copied.
NEXT_PUBLIC_R2_PUBLIC_BASE=https://pub-xxxxx.r2.dev
